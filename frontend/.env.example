# WalletConnect Cloud project ID, used by RainbowKit's connect modal.
# Get one free at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Optional: only set this if you want the frontend to call Alchemy directly.
# Anything prefixed VITE_ is bundled into client-side JS and publicly visible,
# so only use a key restricted (by domain) in the Alchemy dashboard for this.
VITE_ALCHEMY_API_KEY=

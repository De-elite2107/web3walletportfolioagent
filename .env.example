# AI routing - any OpenAI-compatible gateway works (OpenRouter shown below;
# this project was developed against Orbio, a similar OpenAI-compatible
# gateway - swap the base URL for whichever you have a key for)
ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# Model tier for the AI gateway: draft | production | premium (see backend/models.yaml)
MODEL_TIER=draft

# Model used directly by /portfolio/analyze and /portfolio/chat for now
# (ahead of the full tier system) - cheap/fast by default
MODEL_NAME=anthropic/claude-haiku-4.5

# On-chain reads (Alchemy)
ALCHEMY_API_KEY=

# Security scan: contract-verification lookup (primary source; Sourcify is
# the no-key fallback, see app/verification.py). Free at etherscan.io/apis
ETHERSCAN_API_KEY=

# Security scan: known-exploit/scam web search. Free dev key at tavily.com
TAVILY_API_KEY=

# Backend database (SQLAlchemy / PostgreSQL). If you don't already have a
# Postgres instance to point at, run a dedicated one for this project:
#   docker run -d --name orblo-postgres -e POSTGRES_USER=postgres \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=orblo -p 5433:5432 postgres:16-alpine
# then: DATABASE_URL=postgresql://postgres:postgres@localhost:5433/orblo
DATABASE_URL=
